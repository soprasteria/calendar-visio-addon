{
    "name": "sns/calendar-visio-addon",
    "description": "Nextcloud Calendar add-on to create Visio meeting links inside calendar events",
    "type": "nextcloud-app",
    "version": "1.0.0",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "nextcloud/ocp": "dev-master",
        "roave/security-advisories": "dev-latest",
        "vimeo/psalm": "^5",
        "php-cs-fixer/shim": "^3"
    },
    "autoload": {
        "psr-4": {
            "OCA\\CalendarVisioAddon\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\CalendarVisioAddon\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "psalm": "psalm --threads=1",
        "test:unit": "vendor/bin/phpunit -c phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
